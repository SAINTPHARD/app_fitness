# PostgreSQL
POSTGRES_DB=appfitness_db
POSTGRES_USER=appfitness_user
POSTGRES_PASSWORD=appfitness_secure_password_123
POSTGRES_PORT=5432
POSTGRES_HOST=postgres
TZ=America/Sao_Paulo

# Spring Boot
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/appfitness_db
SPRING_DATASOURCE_USERNAME=appfitness_user
SPRING_DATASOURCE_PASSWORD=appfitness_secure_password_123
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_PROFILES_ACTIVE=production

# Frontend
VITE_API_URL=http://localhost:8080
