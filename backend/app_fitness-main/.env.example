# ============================================================================
# Arquivo de Variáveis de Ambiente para Docker
# ============================================================================
# IMPORTANTE: Copie este arquivo para .env e modifique os valores
# Nunca commite o arquivo .env em produção (adicione-o ao .gitignore)

# ============================================================================
# CONFIGURAÇÃO DO POSTGRESQL
# ============================================================================

# Nome do banco de dados padrão
POSTGRES_DB=appfitness_db

# Usuário administrativo do PostgreSQL
POSTGRES_USER=appfitness_user

# SENHA DO POSTGRESQL - MUDE ISTO EM PRODUÇÃO!
# Use senhas fortes com pelo menos 16 caracteres incluindo:
# - Letras maiúsculas (A-Z)
# - Letras minúsculas (a-z)
# - Números (0-9)
# - Caracteres especiais (!@#$%^&*)
POSTGRES_PASSWORD=appfitness_secure_password_123

# ============================================================================
# CONFIGURAÇÃO DA APLICAÇÃO SPRING BOOT
# ============================================================================

# Porta do PostgreSQL (mude se houver conflito local)
POSTGRES_PORT=5432

# Host do PostgreSQL (use 'postgres' quando conectar de outro container)
POSTGRES_HOST=postgres

# Timeout de conexão em segundos
POSTGRES_CONNECT_TIMEOUT=30

# ============================================================================
# CONFIGURAÇÃO DO SPRING BOOT
# ============================================================================

# Profiles válidos neste projeto: dev ou prod
SPRING_PROFILES_ACTIVE=dev

# URL do banco de dados para Spring Boot
# Formato: jdbc:postgresql://host:porta/database?connectionTimeout=valor
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/appfitness_db?connectionTimeout=30

# Usuário do banco para Spring Boot
SPRING_DATASOURCE_USERNAME=appfitness_user

# Senha do banco para Spring Boot
SPRING_DATASOURCE_PASSWORD=substitua_por_uma_senha_local

# Segredos obrigatórios da aplicação. Use valores próprios; nunca versione o .env real.
JWT_SECRET=substitua_por_um_segredo_jwt_com_pelo_menos_64_bytes
GEMINI_API_KEY=substitua_pela_sua_chave_gemini
NINJAS_API_KEY=substitua_pela_sua_chave_api_ninjas

# ============================================================================
# CONFIGURAÇÃO DO HIBERNATE/JPA
# ============================================================================

# Dialeto SQL do Hibernate
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# Estratégia de atualização do schema
# Opções: validate, update, create, create-drop
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Mostrar SQL gerado (false em produção)
SPRING_JPA_SHOW_SQL=false

# ============================================================================
# CONFIGURAÇÃO DE LOGGING
# ============================================================================

# Nível de log
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_APPFITNESS=DEBUG
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK=WARN

# =================-===========================================================
# TIMEZONE
# ============================================================================

# Fuso horário para PostgreSQL
TZ=America/Sao_Paulo
