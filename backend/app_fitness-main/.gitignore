# ============================================================================
# DOCKER E VOLUMES
# ============================================================================
.env                          # Arquivo com variáveis de ambiente (NUNCA versionar!)
.env.local                     # Variáveis locais de desenvolvimento
.env.*.local                   # Variáveis de ambiente específicas
postgres_data/                 # Volume de dados do PostgreSQL
postgres_logs/                 # Logs do PostgreSQL
docker_volumes/                # Volumes gerenciados
docker-compose.override.yml    # Overrides locais

