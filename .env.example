# ============================================================================
# Template de variáveis de ambiente — copie para ".env" na raiz do repo e
# preencha com valores reais. O ".env" nunca deve ser commitado (ver
# .gitignore). Usado tanto pelo docker-compose.yml (raiz) quanto pelo
# backend Spring Boot em dev local (ver application.properties ->
# spring.config.import).
# ============================================================================

# --- Perfil ativo do Spring ---
# dev  -> ddl-auto=update, logs verbosos, fallback de JWT_SECRET inseguro
# prod -> ddl-auto=validate, exige todas as variáveis abaixo sem fallback
SPRING_PROFILES_ACTIVE=dev

# --- PostgreSQL (usado pelo container postgres do docker-compose) ---
POSTGRES_DB=appfitness_db
POSTGRES_USER=appfitness_user
POSTGRES_PASSWORD=troque-esta-senha

# --- Datasource (usado pelo Spring Boot para conectar no Postgres) ---
# Rodando via Docker Compose, o host é o nome do serviço ("postgres"), não
# "localhost" — os containers se enxergam pela rede interna do compose.
# Rodando localmente (sem Docker), troque para localhost:5432.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/appfitness_db
SPRING_DATASOURCE_USERNAME=appfitness_user
SPRING_DATASOURCE_PASSWORD=troque-esta-senha

# --- JWT ---
# Obrigatório em prod (sem fallback). Gere um valor forte, ex:
#   openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-forte-e-aleatorio

# --- Google Gemini (análise de foto de prato) ---
# Opcional: sem isso, só a feature de IA fica indisponível.
GEMINI_API_KEY=

# --- Frontend ---
VITE_API_URL=http://localhost:8080
