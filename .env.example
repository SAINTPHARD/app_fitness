# Local Docker/development template. Never commit a real .env.
SPRING_PROFILES_ACTIVE=dev

POSTGRES_DB=appfitness_db
POSTGRES_USER=appfitness_user
POSTGRES_PASSWORD=troque-esta-senha

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/appfitness_db
SPRING_DATASOURCE_USERNAME=appfitness_user
SPRING_DATASOURCE_PASSWORD=troque-esta-senha

JWT_SECRET=troque-por-um-segredo-forte-e-aleatorio
GEMINI_API_KEY=

# Comma-separated origins accepted by the backend.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Vite build-time public configuration (never put secrets in VITE_* variables).
VITE_API_URL=http://localhost:8080

VITE_SENTRY_DSN=
SENTRY_DSN=
