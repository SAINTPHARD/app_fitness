# ============================================================================
# SEGREDOS — NUNCA versionar
# ============================================================================
# CORREÇÃO: não existia .gitignore nenhum na raiz do repositório antes disso,
# então o .env da raiz (usado pelo docker-compose.yml e pelo backend em dev)
# não estava protegido em lugar nenhum — só o de dentro de
# backend/app_fitness-main/ (que não cobre um .env um nível acima). Ele já
# tinha sido commitado (ver `git log -- .env`); removido do rastreamento
# separadamente, mas os segredos antigos devem ser tratados como
# comprometidos e rotacionados.
.env
.env.local
.env.*.local
backend/.env
backend/app_fitness-main/.env

# ============================================================================
# BUILD / DEPENDÊNCIAS
# ============================================================================
node_modules/
dist/
build/
target/

# ============================================================================
# IDE / SO
# ============================================================================
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# ============================================================================
# LOGS E DADOS LOCAIS
